/extensions/*/dist

# Generated by `npm run build:widget` (esbuild) from storefront-widget/
# widget.tsx - bundled React + widget code, not hand-written source. The
# source lives outside extensions/negotiation-widget/ entirely because
# Shopify's theme app extension structure only allows assets/blocks/
# snippets/locales directories inside it - anything else (a src/ folder,
# a package.json) breaks the CLI's dev preview outright. Must be rebuilt
# after editing storefront-widget/widget.tsx.
/extensions/negotiation-widget/assets/negotiation-widget.js

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Hide files auto-generated by react router
.react-router/

# AI-agent tooling config inherited from the Shopify template - kept on
# disk for local dev (still useful with an AI coding agent), deliberately
# not pushed to the public repo. .github/workflows/gardener-*.yml also
# excluded below (Shopify's own internal bots, wired to secrets this repo
# doesn't have - they'd just fail on every trigger here).
CLAUDE.md
AGENTS.md
/.claude/
/.cursor/
/.gemini/
/.mcp.json
/.github/workflows/gardener-*.yml

